# IotxVideoProxyServer settings.
# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git: never commit real keys.
# Variables already set in the environment (e.g. by PM2) take precedence.

# HTTP port of the proxy
PORT=3002

# IotxApiServer address, used to read the stream list
API_URL=http://localhost:3000
# Same value as PROXY_SERVICE_KEY in the .env of IotxApiServer
PROXY_SERVICE_KEY=
# How often (seconds) the stream list is read again
STREAM_REFRESH_SECONDS=60

# Same value as STREAM_TOKEN_SECRET in the .env of IotxApiServer
STREAM_TOKEN_SECRET=

# Key for trusted clients (IotxStreamWriter, header X-Iotx-Trusted-Key)
# and for the management endpoints (/streamstats, /memory/..., /stream/<id>/close|restart).
# Empty = disabled.
# Generate it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRUSTED_KEY=
