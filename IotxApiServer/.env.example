# IotxApiServer settings.
# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git: never commit real passwords.
# Variables already set in the environment (e.g. by PM2) take precedence.

# HTTP port of the API server
PORT=3000

# PostgreSQL connection
DB_HOST=192.168.1.107
DB_PORT=5432
DB_NAME=datawh
DB_USER=iotx_api
DB_PASSWORD=change-me

# Passwords are stored as hashes (column password_hash).
# Transition period: while an older server version still uses the same database,
# keep this true so that the legacy plaintext column "password" stays up to date.
# Once every server is updated: set it to false and run "npm run hash-passwords -- --clear-plaintext".
PASSWORD_PLAINTEXT_SYNC=true

# Video streams (IotxVideoProxyServer).
# The same two values must be set in the .env of IotxVideoProxyServer.
# Generate each one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty value = the related function is disabled.
# Secret used to sign the tokens that open a stream
STREAM_TOKEN_SECRET=
# Validity of a stream token in hours (checked only when a stream is opened)
STREAM_TOKEN_TTL_HOURS=24
# Key the video proxy uses to read the stream list (GET /proxy/streams)
PROXY_SERVICE_KEY=
